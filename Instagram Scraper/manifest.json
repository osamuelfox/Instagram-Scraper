{
  "manifest_version": 3,
  "name": "Instagram Post Scraper",
  "version": "1.0.0",
  "description": "Coleta automaticamente dados dos posts de perfis do Instagram: link, data, descrição e tipo.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://www.instagram.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["libs/*", "icons/*"],
      "matches": ["https://www.instagram.com/*"]
    }
  ]
}
